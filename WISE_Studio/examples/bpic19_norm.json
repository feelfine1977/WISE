{
  "name": "BPIC'19 purchase-to-pay norm (compact, flow-aware)",
  "version": "1.0",
  "layers": {
    "L1": {"name": "Completion & closure"},
    "L2": {"name": "Timeliness & ageing"},
    "L3": {"name": "Rework & repetition"},
    "L4": {"name": "Exceptions & corrections"},
    "L5": {"name": "Effort & complexity"}
  },
  "constraints": [
    {"id": "c_invoice_present", "layer": "L1", "type": "presence",
     "activity": "Record Invoice Receipt", "min_count": 1,
     "description": "Invoice-bearing flows should record an invoice receipt.",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR", "3-way match, invoice before GR", "2-way match"]}]},
    {"id": "c_clear_invoice_present", "layer": "L1", "type": "presence",
     "activity": "Clear Invoice", "min_count": 1,
     "description": "Invoice-bearing items should eventually reach Clear Invoice (closure).",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR", "3-way match, invoice before GR", "2-way match"]}]},
    {"id": "c_goods_present_3way", "layer": "L1", "type": "presence",
     "activity": "Record Goods Receipt", "min_count": 1,
     "description": "3-way flows expect goods/service receipt evidence.",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR", "3-way match, invoice before GR"]}]},
    {"id": "c_invoice_to_clear_days", "layer": "L2", "type": "lag",
     "from_activity": "Record Invoice Receipt", "to_activity": "Clear Invoice",
     "threshold_days": 30, "saturation_days": 60,
     "description": "Invoices should clear within 30 days (saturates at 90).",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR", "3-way match, invoice before GR", "2-way match"]}]},
    {"id": "c_goods_to_invoice_days", "layer": "L2", "type": "lag",
     "from_activity": "Record Goods Receipt", "to_activity": "Record Invoice Receipt",
     "threshold_days": 20, "saturation_days": 40,
     "description": "Invoice should follow goods receipt within 20 days.",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR"]}]},
    {"id": "c_goods_fragmentation", "layer": "L3", "type": "singularity",
     "activity": "Record Goods Receipt", "allowed": 2, "saturation": 3,
     "description": "Excessive split receiving / posting churn.",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR", "3-way match, invoice before GR"]}]},
    {"id": "c_approval_churn", "layer": "L3", "type": "singularity",
     "activity": "Change Approval for Purchase Order", "allowed": 1, "saturation": 2,
     "description": "Repeated approval changes indicate routing/threshold instability."},
    {"id": "c_cancel_invoice", "layer": "L4", "type": "exclusion",
     "activity": "Cancel Invoice Receipt",
     "description": "Invoice cancellations should be exceptional.",
     "applicability": [{"column": "case Item Category",
       "values": ["3-way match, invoice after GR", "3-way match, invoice before GR", "2-way match"]}]},
    {"id": "c_delete_item", "layer": "L4", "type": "exclusion",
     "activity": "Delete Purchase Order Item",
     "description": "Deleted items signal late corrections."},
    {"id": "c_price_changes", "layer": "L5", "type": "singularity",
     "activity": "Change Price", "allowed": 0, "saturation": 2,
     "description": "Price changes after ordering: commercial-integrity / effort risk."}
  ],
  "views": {
    "Finance":    {"layer_weights": {"L1": 0.30, "L2": 0.35, "L3": 0.10, "L4": 0.10, "L5": 0.15}},
    "Operations": {"layer_weights": {"L1": 0.15, "L2": 0.25, "L3": 0.35, "L4": 0.10, "L5": 0.15}},
    "Compliance": {"layer_weights": {"L1": 0.20, "L2": 0.10, "L3": 0.10, "L4": 0.45, "L5": 0.15}}
  }
}
